// mm_domain_test.bsh -- set up the stacking-domain configuration (second camera + objective + filter) used by
// mm_chip_scan.bsh for graphite: measures its XY and focus offsets from the 100x objective, its pixel size and
// orientation, and tests the autofocus with this camera.
//
// Micro-Manager 2.0 Script Panel.
//   1. With the 100x objective and the scan camera, centre a small, sharp feature (a flake corner, a
//      graphite edge, dust) and focus roughly.  A feature with structure in both X and Y works best.
//   2. Run this script.  It autofocuses at 100x and saves a reference frame.
//   3. When asked, change to the domain objective, camera and filter without moving the stage or focus.
//   4. The script then (stage moves stay within a few fields of the start):
//        - finds the focus with the domain camera (wide search; you focus by hand if that fails),
//        - measures the domain camera's pixel size, rotation and mirroring from small stage moves,
//        - finds the XY offset by matching the domain frame to the 100x reference, moves there,
//          checks the match and lets you correct the centring by hand,
//        - focus offset = domain focus - 100x focus at the same feature,
//        - sweeps Z (sharpness curve -> <NAME>_sweep.csv / .png), measures the sharpness noise and runs the
//          autofocus from several starting points with the DOMAIN_AF settings of mm_chip_scan.bsh,
//        - writes <NAME>_log.txt, <NAME>_domain.json and prints the lines to copy into mm_chip_scan.bsh.
//   The stage ends at the feature with the domain configuration in place.
//
// START_AT_100X = false skips the offsets (the domain configuration is already in, focused roughly):
// only the pixel calibration and the autofocus test are done.
// Keep the autofocus code identical to mm_chip_scan.bsh (toIP, sharpness, sweep, despike, autofocusScript).

import java.io.*;

// ---------------------------------------------------------------- method reset (see mm_chip_scan.bsh)
SCRIPT_VERSION = "dom-2026-10-02a";
try {
    mf = bsh.NameSpace.class.getDeclaredField("methods");
    mf.setAccessible(true);
    mtab = mf.get(this.namespace);
    if (mtab != null) {
        ours = new String[] { "has", "say", "fail", "zRead", "zWrite", "f1", "f3", "median", "setZ", "toIP", "sharpness", "sweep",
                              "autofocusScript", "despike", "snapIP", "gray", "level", "saveIP", "pow2", "prep", "xcorr", "toGrid",
                              "inv2", "moveXY", "askFocus", "applyProps", "domVersion", "stopStreaming" };
        for (int i = 0; i < ours.length; i++) mtab.remove(ours[i]);
    }
} catch (Throwable t) { print("  (could not reset old method definitions: " + t + ")"); }
String domVersion() { return "dom-2026-10-02a"; }
if (!domVersion().equals(SCRIPT_VERSION))
    throw new Exception("old script code is still loaded (" + domVersion() + "); restart Micro-Manager and run again");

// ---------------------------------------------------------------- settings
OUT_DIR        = "C:/scans";
NAME           = "domaintest";
START_AT_100X  = true;             // true: start at 100x on a feature (measures the offsets); false: domain configuration already in
// the domain configuration (copy the same values into mm_chip_scan.bsh)
DOMAIN_CAMERA  = "Raptor Owl Camera 640";   // Micro-Manager camera device of the domain camera; "" = the camera selected when you press OK
DOMAIN_CAMERA_PROPS = new String[][] { { "High Gain", "Off" }, { "Frame Average", "4" } };   // { property, value [, "optional"] }
DOMAIN_EXPOSURE_MS = 28.0;         // ms
DOMAIN_AUTO_EXPOSURE = false;      // true: adjust the exposure until the median is at DOMAIN_LEVEL (the result is printed)
DOMAIN_LEVEL   = 0.35;             // median as a fraction of full scale for DOMAIN_AUTO_EXPOSURE
DOMAIN_BAYER   = false;            // true if the domain camera gives a raw colour mosaic (16 bit Bayer); false: monochrome / RGB
DOMAIN_FOCUS_OFFSET_GUESS = 0.0;   // um: where to start looking for the domain focus, relative to the 100x focus
DOMAIN_SEARCH  = new double[] { 30.0, 1.0, 1.5, 0.25, 0.9 };  // first focus: {coarse +-range, coarse step, fine +-range, fine step, centre fraction}
DOMAIN_AF_FIRST = new double[] { 15.0, 1.0, 1.5, 0.25, 0.9 }; // as in mm_chip_scan.bsh: first flake
DOMAIN_AF      = new double[] { 4.0, 0.8, 1.5, 0.25, 0.9 };   // as in mm_chip_scan.bsh: later flakes
// 100x (the scan camera, as set up for mm_chip_scan.bsh's 100x images)
AF100_FIRST    = new double[] { 15.0, 1.0, 1.0, 0.25, 0.9 };
REF_BAYER      = true;             // the scan camera's RAW16 frames are a Bayer mosaic
M00 = -1.0905; M01 = -0.0067;      // 10x pixel -> stage matrix (um per px), as in mm_chip_scan.bsh; 100x = this / RATIO_100X
M10 =  0.0066; M11 = -1.0917;
RATIO_100X     = 9.54;
// test
CONFIRM_XY     = true;             // after the automatic match: live view, you can centre the feature by hand
SWEEP_RANGE_UM = 8.0;              // diagnostic sweep +-range around the domain focus
SWEEP_STEP_UM  = 0.2;
REPEATS        = 8;                // frames at one Z for the noise of the sharpness
TEST_OFFSETS_UM = new double[] { 0.0, 3.0, -3.0 };   // autofocus starts relative to the focus
CAL_FRACTION   = 0.20;             // pixel calibration moves: this fraction of the field
MIN_MATCH      = 1.5;              // image match accepted if its peak is this many times the next best peak
MAX_DZ_UM      = 150.0;            // safety: never further than this from the start Z (real um)
MAX_XY_UM      = 3000.0;           // safety: never further than this from the start position
Z_STEPSIZE_UM  = 0.0250 / 12.0;    // as in mm_chip_scan.bsh
Z_SCALE        = 12.0;
AF_EXTEND      = 2;
AF_MIN_RATIO   = 1.10;
AF_BACKLASH_UM = 5.0;
SPIKE_FACTOR   = 3.0;
Z_SETTLE_MS    = 20;
VERBOSE        = true;
// ----------------------------------------------------------------

boolean has(Object o, String name) {
    if (o == null) return false;
    java.lang.reflect.Method[] ms = o.getClass().getMethods();
    for (int i = 0; i < ms.length; i++) if (ms[i].getName().equals(name)) return true;
    return false;
}
new File(OUT_DIR).mkdirs();
LOG = new FileWriter(OUT_DIR + "/" + NAME + "_log.txt", false);
void say(String msg) {
    print(msg);
    try { LOG.write(msg + "\r\n"); LOG.flush(); } catch (Throwable t) { }
}
Exception fail(String msg) { say("ERROR: " + msg); return new Exception(msg); }
String f1(double v) { return "" + (Math.round(v * 10.0) / 10.0); }
String f3(double v) { return "" + (Math.round(v * 1000.0) / 1000.0); }
double median(double[] a) { double[] c = java.util.Arrays.copyOf(a, a.length); java.util.Arrays.sort(c); return c[c.length / 2]; }

xyDev = mmc.getXYStageDevice();
zDev = mmc.getFocusDevice();
if (zDev == null || zDev.length() == 0) throw fail("no focus device");
if (has(mm, "live") && has(mm.live(), "setLiveMode") && mm.live().getIsLiveModeOn()) mm.live().setLiveMode(false);
W = (int) mmc.getImageWidth();
H = (int) mmc.getImageHeight();
double zRead() { return mmc.getPosition(zDev) / Z_SCALE; }
void zWrite(double z) { mmc.setPosition(zDev, z * Z_SCALE); }
if (Z_STEPSIZE_UM > 0) {
    if (!mmc.hasProperty(zDev, "StepSize_um")) throw fail(zDev + " has no StepSize_um property; set Z_STEPSIZE_UM = 0 and Z_SCALE by hand");
    zsOld = mmc.getProperty(zDev, "StepSize_um");
    if (Math.abs(Double.parseDouble(zsOld) - Z_STEPSIZE_UM) > 1e-7) {
        try { mmc.setProperty(zDev, "StepSize_um", "" + Z_STEPSIZE_UM); mmc.waitForDevice(zDev); }
        catch (Throwable t) { say("  (" + zDev + " StepSize_um cannot be set: " + t.getMessage() + ")"); }
    }
    Z_SCALE = Double.parseDouble(mmc.getProperty(zDev, "StepSize_um")) / Z_STEPSIZE_UM;
}
Z0 = zRead();
X0 = mmc.getXPosition(xyDev); Y0 = mmc.getYPosition(xyDev);
nSnaps = 0;

// ---------------------------------------------------------------- autofocus code (as in mm_chip_scan.bsh)
boolean setZ(double z) {
    if (Math.abs(z - Z0) > MAX_DZ_UM) return false;
    zWrite(z);
    mmc.waitForDevice(zDev);
    if (Z_SETTLE_MS > 0) Thread.sleep((long) Z_SETTLE_MS);
    return true;
}
// a camera frame as an ImageJ processor: 8 bit, 16 bit (raw Bayer or monochrome), RGB32 or 32-bit float
ij.process.ImageProcessor toIP(Object img, int w, int h) {
    if (img instanceof short[]) return new ij.process.ShortProcessor(w, h, (short[]) img, null);
    if (img instanceof byte[]) return new ij.process.ByteProcessor(w, h, (byte[]) img, null);
    if (img instanceof float[]) return new ij.process.FloatProcessor(w, h, (float[]) img, null);
    return new ij.process.ColorProcessor(w, h, (int[]) img);
}
double sharpness(double roi) {
    mmc.snapImage();
    Object img = mmc.getImage();
    nSnaps++;
    ij.process.ImageProcessor ip = toIP(img, W, H);
    int rw = ((int) (W * roi)) & ~1, rh = ((int) (H * roi)) & ~1;
    ip.setRoi(((W - rw) / 2) & ~1, ((H - rh) / 2) & ~1, rw, rh);
    ij.process.ImageProcessor c = ip.crop().convertToFloat().bin(2);   // 2x2 bin removes the colour mosaic
    double mean = c.getStatistics().mean;
    c.findEdges();
    return c.getStatistics().mean / Math.max(mean, 1.0);
}
int sweep(double[] zs, double[] ms, double roi) {
    setZ(zs[0] - AF_BACKLASH_UM);
    for (int i = 0; i < zs.length; i++) {
        if (setZ(zs[i])) ms[i] = sharpness(roi); else ms[i] = -1.0;
    }
    despike(zs, ms, roi);
    int bi = -1;
    for (int i = 0; i < zs.length; i++) if (bi < 0 || ms[i] > ms[bi]) bi = i;
    return bi;
}
void despike(double[] zs, double[] ms, double roi) {
    for (int i = 0; i < zs.length; i++) {
        if (ms[i] <= 0) continue;
        double nb = -1;
        if (i > 0) nb = Math.max(nb, ms[i - 1]);
        if (i < zs.length - 1) nb = Math.max(nb, ms[i + 1]);
        if (nb <= 0 || ms[i] < SPIKE_FACTOR * nb) continue;
        setZ(zs[i] - AF_BACKLASH_UM); setZ(zs[i]);
        double again = sharpness(roi);
        if (VERBOSE) say("      sharpness spike at Z " + f3(zs[i]) + " (" + f3(ms[i]) + " vs neighbours " + f3(nb) + "): re-measured " + f3(again));
        ms[i] = again;
    }
}
double[] autofocusScript(double zc, double[] p) {
    long t0 = System.currentTimeMillis();
    double lo = zc - p[0], hi = zc + p[0];
    double bestZ = zc, ratio = 0.0;
    for (int ext = 0; ext <= AF_EXTEND; ext++) {
        int n = (int) Math.round((hi - lo) / p[1]) + 1;
        double[] zs = new double[n], ms = new double[n];
        for (int i = 0; i < n; i++) zs[i] = lo + i * p[1];
        int bi = sweep(zs, ms, p[4]);
        double[] valid = new double[n]; int nv = 0;
        for (int i = 0; i < n; i++) if (ms[i] >= 0) valid[nv++] = ms[i];
        if (nv < 3) break;
        ratio = ms[bi] / Math.max(median(java.util.Arrays.copyOf(valid, nv)), 1e-9);
        bestZ = zs[bi];
        if (ratio < AF_MIN_RATIO) break;
        if (bi == 0 && ext < AF_EXTEND) { hi = lo + p[1]; lo = hi - 2 * p[0]; continue; }
        if (bi == n - 1 && ext < AF_EXTEND) { lo = hi - p[1]; hi = lo + 2 * p[0]; continue; }
        break;
    }
    if (ratio < AF_MIN_RATIO) {
        if (VERBOSE) say("      autofocus: no focus signal (peak/median " + f3(ratio) + ")");
        setZ(zc);
        return new double[] { zc, ratio, 0 };
    }
    int nf = (int) Math.round(2 * p[2] / p[3]) + 1;
    double[] zf = new double[nf], mf = new double[nf];
    for (int i = 0; i < nf; i++) zf[i] = bestZ - p[2] + i * p[3];
    int fi = sweep(zf, mf, p[4]);
    if (fi <= 1 || fi >= nf - 2) {
        double zc2 = zf[fi];
        for (int i = 0; i < nf; i++) zf[i] = zc2 - p[2] + i * p[3];
        fi = sweep(zf, mf, p[4]);
        if (VERBOSE) say("      fine sweep re-centred on Z " + f3(zc2));
    }
    double z = zf[fi];
    double mmin = 1e30;
    for (int i = 0; i < nf; i++) if (mf[i] > 0) mmin = Math.min(mmin, mf[i]);
    double thr = Math.log(mmin) + 0.5 * (Math.log(mf[fi]) - Math.log(mmin));
    double s0 = 0, s1 = 0, s2 = 0, s3 = 0, s4 = 0, q0 = 0, q1 = 0, q2 = 0, zlo = 1e30, zhi = -1e30;
    int np = 0;
    for (int i = 0; i < nf; i++) {
        if (mf[i] <= 0 || Math.log(mf[i]) < thr) continue;
        double u = zf[i] - zf[fi], y = Math.log(mf[i]);
        s0 += 1; s1 += u; s2 += u * u; s3 += u * u * u; s4 += u * u * u * u; q0 += y; q1 += u * y; q2 += u * u * y;
        zlo = Math.min(zlo, zf[i]); zhi = Math.max(zhi, zf[i]); np++;
    }
    if (np >= 3) {
        double det = s0 * (s2 * s4 - s3 * s3) - s1 * (s1 * s4 - s3 * s2) + s2 * (s1 * s3 - s2 * s2);
        if (Math.abs(det) > 1e-12) {
            double c1 = (s0 * (q1 * s4 - s3 * q2) - q0 * (s1 * s4 - s3 * s2) + s2 * (s1 * q2 - q1 * s2)) / det;
            double c2 = (s0 * (s2 * q2 - q1 * s3) - s1 * (s1 * q2 - q1 * s2) + q0 * (s1 * s3 - s2 * s2)) / det;
            if (c2 < 0) z = Math.max(zlo, Math.min(zhi, zf[fi] - c1 / (2 * c2)));
        }
    }
    setZ(z - AF_BACKLASH_UM);
    setZ(z);
    if (VERBOSE) say("      autofocus: Z " + f3(z) + " (peak/median " + f3(ratio) + ", " +
                     ((System.currentTimeMillis() - t0) / 1000.0) + " s)");
    return new double[] { z, ratio, 1 };
}

// ---------------------------------------------------------------- helpers for the offsets
// live view or a sequence acquisition (e.g. started while changing the camera) blocks snaps and property changes
void stopStreaming() {
    try { if (has(mm, "live") && has(mm.live(), "getIsLiveModeOn") && mm.live().getIsLiveModeOn()) mm.live().setLiveMode(false); } catch (Throwable t) { }
    try { if (has(mmc, "isSequenceRunning") && mmc.isSequenceRunning()) { mmc.stopSequenceAcquisition(); say("    (stopped a running sequence acquisition / live view)"); } } catch (Throwable t) { }
}
ij.process.ImageProcessor snapIP() { stopStreaming(); mmc.snapImage(); nSnaps++; return toIP(mmc.getImage(), W, H); }
// brightness as float; a Bayer mosaic is binned 2x2 (then one pixel = 2 camera pixels)
ij.process.FloatProcessor gray(ij.process.ImageProcessor ip, boolean bayer) {
    ij.process.ImageProcessor f = ip.convertToFloat();
    if (bayer && ip instanceof ij.process.ShortProcessor) f = f.bin(2);
    return (ij.process.FloatProcessor) f;
}
// {median, saturated fraction} of a frame as fractions of full scale
double[] level(ij.process.ImageProcessor ip) {
    double fs = (ip instanceof ij.process.ColorProcessor || ip instanceof ij.process.ByteProcessor) ? 255.0 : Math.pow(2, (double) mmc.getImageBitDepth()) - 1;
    ij.process.ImageStatistics st = ij.process.ImageStatistics.getStatistics(ip, ij.measure.Measurements.MEDIAN, null);
    int sat = 0, n = ip.getWidth() * ip.getHeight();
    if (ip instanceof ij.process.ShortProcessor) {
        int[] hist = ip.getHistogram();
        for (int b = (int) fs - 1; b < hist.length; b++) sat += hist[b];
    }
    return new double[] { st.median / fs, sat / (double) n };
}
void saveIP(ij.process.ImageProcessor ip, String file, String info) {
    ij.ImagePlus imp = new ij.ImagePlus(file, ip);
    imp.setProperty("Info", info);
    ij.IJ.saveAsTiff(imp, OUT_DIR + "/" + file);
}
int pow2(int n) { int p = 64; while (p * 2 <= n) p *= 2; return p; }
// n x n centre crop -> edge strength, mean removed, Hann window (makes the match independent of brightness,
// colour and filter: edges are where the images agree)
ij.process.FloatProcessor prep(ij.process.FloatProcessor g, int n) {
    ij.process.FloatProcessor c = g;
    if (g.getWidth() != n || g.getHeight() != n) {
        g.setRoi((g.getWidth() - n) / 2, (g.getHeight() - n) / 2, n, n);
        c = (ij.process.FloatProcessor) g.crop();
    }
    c = (ij.process.FloatProcessor) c.duplicate();
    c.findEdges();
    double m = c.getStatistics().mean;
    for (int j = 0; j < n; j++) {
        double wy = 0.5 - 0.5 * Math.cos(2 * Math.PI * j / (n - 1));
        for (int i = 0; i < n; i++) {
            double wx = 0.5 - 0.5 * Math.cos(2 * Math.PI * i / (n - 1));
            c.setf(i, j, (float) ((c.getf(i, j) - m) * wx * wy));
        }
    }
    return c;
}
// shift s (px) with b(p) = a(p - s), by cross-correlation; {sx, sy, peak / next best peak}
double[] xcorr(ij.process.FloatProcessor a, ij.process.FloatProcessor b) {
    int n = a.getWidth();
    ij.process.FHT fa = new ij.process.FHT(a); fa.transform();
    ij.process.FHT fb = new ij.process.FHT(b); fb.transform();
    ij.process.FHT c = fb.conjugateMultiply(fa); c.inverseTransform(); c.swapQuadrants();
    int bx = 0, by = 0; double bv = -1e30;
    for (int y = 1; y < n - 1; y++) for (int x = 1; x < n - 1; x++) if (c.getf(x, y) > bv) { bv = c.getf(x, y); bx = x; by = y; }
    double second = 0;
    int ex = Math.max(4, n / 64);
    for (int y = 1; y < n - 1; y++) for (int x = 1; x < n - 1; x++)
        if ((Math.abs(x - bx) > ex || Math.abs(y - by) > ex) && c.getf(x, y) > second) second = c.getf(x, y);
    // sub-pixel: parabola through the peak in x and in y
    double l = c.getf(bx - 1, by), r = c.getf(bx + 1, by), u = c.getf(bx, by - 1), d = c.getf(bx, by + 1);
    double dx = (l - 2 * bv + r) != 0 ? 0.5 * (l - r) / (l - 2 * bv + r) : 0, dy = (u - 2 * bv + d) != 0 ? 0.5 * (u - d) / (u - 2 * bv + d) : 0;
    return new double[] { bx + Math.max(-0.5, Math.min(0.5, dx)) - n / 2, by + Math.max(-0.5, Math.min(0.5, dy)) - n / 2, bv / Math.max(second, 1e-12) };
}
// resample an image onto an n x n grid aligned with the stage axes, g um per grid pixel, centred on the frame
// centre.  m = the image's pixel -> stage matrix (um per image pixel).  Outside the image: the image mean.
ij.process.FloatProcessor toGrid(ij.process.FloatProcessor img, double[] m, int n, double g) {
    double[] mi = inv2(m);
    double sc = g / Math.sqrt(Math.abs(m[0] * m[3] - m[1] * m[2]));   // image px per grid px
    ij.process.FloatProcessor src = img;
    if (sc > 1.5) {                                                      // smooth first: no aliasing
        src = (ij.process.FloatProcessor) img.duplicate();
        new ij.plugin.filter.GaussianBlur().blurGaussian(src, 0.5 * sc, 0.5 * sc, 0.01);
    }
    float mean = (float) src.getStatistics().mean;
    double cx = img.getWidth() / 2.0, cy = img.getHeight() / 2.0;
    int w = img.getWidth(), h = img.getHeight();
    ij.process.FloatProcessor out = new ij.process.FloatProcessor(n, n);
    for (int j = 0; j < n; j++) {
        double vy = (j - n / 2) * g;
        for (int i = 0; i < n; i++) {
            double vx = (i - n / 2) * g;
            double px = cx + mi[0] * vx + mi[1] * vy, py = cy + mi[2] * vx + mi[3] * vy;
            out.setf(i, j, (px >= 0 && py >= 0 && px < w - 1 && py < h - 1) ? (float) src.getInterpolatedPixel(px, py) : mean);
        }
    }
    return out;
}
double[] inv2(double[] m) {
    double d = m[0] * m[3] - m[1] * m[2];
    return new double[] { m[3] / d, -m[1] / d, -m[2] / d, m[0] / d };
}
void moveXY(double x, double y) {
    if (Math.hypot(x - X0, y - Y0) > MAX_XY_UM) throw fail("move to " + f1(x) + ", " + f1(y) + " is beyond MAX_XY_UM from the start");
    mmc.setXYPosition(xyDev, x, y);
    mmc.waitForDevice(xyDev);
}
// manual focus / centring: live view + dialog.  Returns 0 = OK, 1 = no, 2 = stop
int askFocus(String title, String what) {
    if (java.awt.GraphicsEnvironment.isHeadless()) {
        if (has(mmc, "mockFocus")) { mmc.mockFocus(); return 0; }
        return 1;
    }
    if (has(mm, "live") && has(mm.live(), "setLiveMode")) mm.live().setLiveMode(true);
    int ans = javax.swing.JOptionPane.showConfirmDialog(null, what, title, javax.swing.JOptionPane.YES_NO_CANCEL_OPTION);
    if (has(mm, "live") && has(mm.live(), "setLiveMode")) mm.live().setLiveMode(false);
    if (ans == javax.swing.JOptionPane.YES_OPTION) return 0;
    if (ans == javax.swing.JOptionPane.NO_OPTION) return 1;
    return 2;
}
void applyProps(String cam, String[][] props) {
    for (int i = 0; i < props.length; i++) {
        String nm = props[i][0], want = props[i][1];
        boolean opt = props[i].length > 2;
        if (!mmc.hasProperty(cam, nm)) { if (!opt) throw fail(nm + " is not a property of " + cam); continue; }
        try { mmc.setProperty(cam, nm, want); } catch (Throwable t) { if (!opt) throw fail("could not set " + nm + " = " + want + " on " + cam + ": " + t.getMessage()); }
        say("    " + cam + " " + nm + " = " + mmc.getProperty(cam, nm));
    }
}

// ================================================================ run
say("domain configuration test (" + SCRIPT_VERSION + "): start " + f1(X0) + ", " + f1(Y0) + " um, Z " + f3(Z0) + " um, camera " +
    mmc.getCameraDevice() + " " + W + " x " + H + ", exposure " + f3(mmc.getExposure()) + " ms");
M100 = new double[] { M00 / RATIO_100X, M01 / RATIO_100X, M10 / RATIO_100X, M11 / RATIO_100X };
cam100 = mmc.getCameraDevice();
z100 = Double.NaN; ref = null; mRef = null;

// ---- 1. 100x reference
if (START_AT_100X) {
    say("  1. 100x reference at " + f1(X0) + ", " + f1(Y0));
    r_ = autofocusScript(Z0, AF100_FIRST);
    if (r_[2] < 0.5) {
        a_ = askFocus("Domain test: 100x", "The 100x autofocus found no focus here.\nFocus by hand (live view is on), then press Yes.\n(No / Cancel = stop)");
        if (a_ != 0) throw fail("no 100x focus");
    }
    z100 = zRead();
    ip_ = snapIP();
    lv_ = level(ip_);
    saveIP(ip_, NAME + "_100x.tif", "stage_x_um=" + X0 + "\nstage_y_um=" + Y0 + "\nz_um=" + z100 + "\ncamera=" + cam100);
    ref = gray(ip_, REF_BAYER);
    bf_ = (REF_BAYER && ip_ instanceof ij.process.ShortProcessor) ? 2.0 : 1.0;
    mRef = new double[] { M100[0] * bf_, M100[1] * bf_, M100[2] * bf_, M100[3] * bf_ };
    say("    100x focus Z " + f3(z100) + " um; frame median " + f1(lv_[0] * 100) + " % of full scale; saved " + NAME + "_100x.tif");

    // ---- 2. change the configuration
    if (!java.awt.GraphicsEnvironment.isHeadless()) {
        ans_ = javax.swing.JOptionPane.showConfirmDialog(null,
            "Now change to the stacking-domain configuration:\n" +
            "   - the domain objective\n   - the domain camera (and select it in Micro-Manager if DOMAIN_CAMERA is empty)\n   - the filter\n\n" +
            "Do not move the stage or the focus.  Press OK when everything is in place.",
            "Domain test: change the configuration", javax.swing.JOptionPane.OK_CANCEL_OPTION);
        if (ans_ != javax.swing.JOptionPane.OK_OPTION) throw fail("cancelled");
    } else if (has(mmc, "mockDomain")) mmc.mockDomain();               // simulator
}

// ---- 3. domain camera
stopStreaming();
if (DOMAIN_CAMERA.length() > 0 && !DOMAIN_CAMERA.equals(mmc.getCameraDevice())) {
    try { mmc.setCameraDevice(DOMAIN_CAMERA); } catch (Throwable t) { throw fail("cannot select camera " + DOMAIN_CAMERA + ": " + t.getMessage()); }
}
camD = mmc.getCameraDevice();
if (START_AT_100X && camD.equals(cam100))
    say("    (the camera device is still " + camD + ": fine if the domain camera replaced the scan camera under the same name)");
applyProps(camD, DOMAIN_CAMERA_PROPS);
mmc.setExposure(DOMAIN_EXPOSURE_MS);
mmc.waitForDevice(camD);
W = (int) mmc.getImageWidth();
H = (int) mmc.getImageHeight();
ip_ = snapIP();
lv_ = level(ip_);
for (int it = 0; DOMAIN_AUTO_EXPOSURE && it < 8; it++) {
    if (lv_[1] < 0.001 && Math.abs(lv_[0] / DOMAIN_LEVEL - 1) < 0.15) break;
    ex_ = mmc.getExposure();
    nex_ = Math.max(0.05, Math.min(5000.0, ex_ * ((lv_[0] > 0.9 || lv_[1] > 0.3) ? 0.1 : DOMAIN_LEVEL / Math.max(lv_[0], 0.002))));
    if (Math.abs(nex_ - ex_) < 1e-6) break;
    mmc.setExposure(nex_); mmc.waitForDevice(camD);
    say("    exposure " + f3(ex_) + " -> " + f3(nex_) + " ms (median " + f1(lv_[0] * 100) + " %, " + f3(lv_[1] * 100) + " % saturated)");
    ip_ = snapIP(); lv_ = level(ip_);
}
expD = mmc.getExposure();
bayerD = DOMAIN_BAYER && ip_ instanceof ij.process.ShortProcessor;
say("  3. domain camera " + camD + ": " + W + " x " + H + ", " + ip_.getBitDepth() + " bit" + (bayerD ? " (Bayer)" : "") + ", exposure " + f3(expD) +
    " ms, median " + f1(lv_[0] * 100) + " % of full scale, " + f3(lv_[1] * 100) + " % saturated");
if (lv_[0] < 0.01) throw fail("the domain image is (nearly) black: light path / filter / shutter, or a longer DOMAIN_EXPOSURE_MS");

// ---- 4. domain focus (wide search)
zs0_ = START_AT_100X ? z100 + DOMAIN_FOCUS_OFFSET_GUESS : Z0;
say("  4. domain focus: search around Z " + f3(zs0_) + " (+-" + f1(DOMAIN_SEARCH[0]) + " um, extended up to " + AF_EXTEND + " times)");
r_ = autofocusScript(zs0_, DOMAIN_SEARCH);
focusHow = "auto";
if (r_[2] < 0.5) {
    a_ = askFocus("Domain test: focus", "No focus found with the domain camera.\nFocus by hand (live view is on), then press Yes.\n(No / Cancel = stop)");
    if (a_ != 0) throw fail("no domain focus");
    focusHow = "manual";
}
zD = zRead();
say("    domain focus Z " + f3(zD) + " um (" + focusHow + ")" + (START_AT_100X ? "; domain - 100x = " + f3(zD - z100) + " um" : ""));

// ---- 5. pixel calibration: stage moves -> image shifts (b(p) = a(p - s) with s = -Md^-1 d)
gb_ = bayerD ? 2.0 : 1.0;
g0 = gray(snapIP(), bayerD);
nC = Math.min(512, pow2(Math.min(g0.getWidth(), g0.getHeight())));
a0 = prep(g0, nC);
x1_ = X0 + 2.0;
moveXY(x1_, Y0);
s1_ = xcorr(a0, prep(gray(snapIP(), bayerD), nC));
px1_ = Math.hypot(s1_[0], s1_[1]);
if (px1_ < 0.5) throw fail("a 2 um stage move did not shift the domain image (" + f3(px1_) + " px): is the image in focus, with structure?");
umpx_ = 2.0 / px1_;                                                     // rough um per (binned) px
D_ = CAL_FRACTION * nC * umpx_;
say("  5. pixel calibration: 2 um move -> " + f1(px1_) + " px (about " + f3(umpx_ / gb_) + " um per camera px); calibration moves " + f1(D_) + " um");
moveXY(X0 + D_, Y0);
sx_ = xcorr(a0, prep(gray(snapIP(), bayerD), nC));
moveXY(X0, Y0 + D_);
sy_ = xcorr(a0, prep(gray(snapIP(), bayerD), nC));
moveXY(X0, Y0);
s0_ = xcorr(a0, prep(gray(snapIP(), bayerD), nC));
say("    +X: shift " + f3(sx_[0]) + ", " + f3(sx_[1]) + " px (match " + f1(sx_[2]) + ");  +Y: " + f3(sy_[0]) + ", " + f3(sy_[1]) + " px (match " + f1(sy_[2]) +
    ");  back at the start: " + f3(s0_[0]) + ", " + f3(s0_[1]) + " px (stage repeatability)");
if (sx_[2] < MIN_MATCH || sy_[2] < MIN_MATCH) say("    WARNING: weak image match during the calibration: use a feature with more structure");
// Md^-1 = -[sx sy] / D  (columns)
mi_ = new double[] { -sx_[0] / D_, -sy_[0] / D_, -sx_[1] / D_, -sy_[1] / D_ };
mDb = inv2(mi_);                                                        // um per (binned) px
mD = new double[] { mDb[0] / gb_, mDb[1] / gb_, mDb[2] / gb_, mDb[3] / gb_ };   // um per camera px
pxD = Math.sqrt(Math.abs(mD[0] * mD[3] - mD[1] * mD[2]));
mirror_ = (mD[0] * mD[3] - mD[1] * mD[2]) * (M00 * M11 - M01 * M10) < 0;
rotD = Math.toDegrees(Math.atan2(mD[2], mD[0]));
rot100 = Math.toDegrees(Math.atan2(M10, M00));
rotRel = rotD - rot100; while (rotRel > 180) rotRel -= 360; while (rotRel <= -180) rotRel += 360;
skew_ = Math.abs(Math.hypot(mD[0], mD[2]) / Math.hypot(mD[1], mD[3]) - 1);
fovX = Math.abs(mD[0]) * W + Math.abs(mD[1]) * H; fovY = Math.abs(mD[2]) * W + Math.abs(mD[3]) * H;
say("    domain pixel -> stage: [" + f3(mD[0]) + ", " + f3(mD[1]) + "; " + f3(mD[2]) + ", " + f3(mD[3]) + "] um per px: " + f3(pxD) + " um per px, field " +
    f1(fovX) + " x " + f1(fovY) + " um; rotated " + f1(rotRel) + " deg against the scan camera" + (mirror_ ? ", MIRRORED" : "") +
    (skew_ > 0.03 ? "; X and Y scales differ by " + f1(skew_ * 100) + " % (check the calibration)" : ""));
say("    domain pixels are " + f3(Math.sqrt(Math.abs(M100[0] * M100[3] - M100[1] * M100[2])) / pxD) + " x finer than the 100x pixels");

// ---- 6. XY offset: domain frame against the 100x reference on a common stage-aligned grid
offX = Double.NaN; offY = Double.NaN; xyHow = "";
if (START_AT_100X) {
    ext100 = Math.min(ref.getWidth() * Math.abs(mRef[0]) + ref.getHeight() * Math.abs(mRef[1]), ref.getWidth() * Math.abs(mRef[2]) + ref.getHeight() * Math.abs(mRef[3]));
    extD = Math.min(fovX, fovY);
    nG = 512;
    gG = Math.max(Math.max(Math.sqrt(Math.abs(mRef[0] * mRef[3] - mRef[1] * mRef[2])), pxD * gb_), Math.min(ext100, extD) / nG);
    say("  6. XY offset: matching on a " + nG + " x " + nG + " grid, " + f3(gG) + " um per grid px (" + f1(nG * gG) + " um across; offsets up to +-" +
        f1(nG * gG / 2) + " um are found)");
    gRef = prep(toGrid(ref, mRef, nG, gG), nG);
    gDom = prep(toGrid(gray(snapIP(), bayerD), mDb, nG, gG), nG);
    m_ = xcorr(gRef, gDom);
    offX = m_[0] * gG; offY = m_[1] * gG;
    say("    match: domain - 100x = " + f3(offX) + ", " + f3(offY) + " um (match " + f1(m_[2]) + ")");
    if (m_[2] < MIN_MATCH) say("    WARNING: weak match (" + f1(m_[2]) + " < " + MIN_MATCH + "): the domain image may look too different; check by hand below");
    xyHow = "image match";
    // check: at the offset position the domain frame should show the 100x centre at its centre
    moveXY(X0 + offX, Y0 + offY);
    gChk = prep(toGrid(gray(snapIP(), bayerD), mDb, nG, gG), nG);
    c_ = xcorr(gRef, gChk);
    say("    check at " + f1(X0 + offX) + ", " + f1(Y0 + offY) + ": residual " + f3(c_[0] * gG) + ", " + f3(c_[1] * gG) + " um (match " + f1(c_[2]) + ")");
    if (Math.hypot(c_[0] * gG, c_[1] * gG) > 2.0 && c_[2] >= MIN_MATCH) {
        offX += c_[0] * gG; offY += c_[1] * gG;
        moveXY(X0 + offX, Y0 + offY);
        say("    corrected once: offset " + f3(offX) + ", " + f3(offY) + " um");
    }
    saveIP(snapIP(), NAME + "_domain_at_offset.tif", "stage_x_um=" + (X0 + offX) + "\nstage_y_um=" + (Y0 + offY) + "\nz_um=" + zD + "\ncamera=" + camD);
    if (CONFIRM_XY && !java.awt.GraphicsEnvironment.isHeadless()) {
        a_ = askFocus("Domain test: XY offset",
            "The feature that was at the centre of the 100x image should now be at the centre of the domain image.\n" +
            "If it is not, centre it with the stage (live view is on).\n\n" +
            "Yes = use the position now     No = keep the automatic result     Cancel = stop");
        if (a_ == 2) throw fail("cancelled");
        if (a_ == 0) {
            mmc.waitForDevice(xyDev);
            hx_ = mmc.getXPosition(xyDev) - X0; hy_ = mmc.getYPosition(xyDev) - Y0;
            if (Math.hypot(hx_ - offX, hy_ - offY) > 0.05) {
                say("    centred by hand: " + f3(hx_) + ", " + f3(hy_) + " um (" + f3(hx_ - offX) + ", " + f3(hy_ - offY) + " from the automatic result)");
                xyHow = "by hand";
            }
            offX = hx_; offY = hy_;
        }
    }
}

// ---- 7. autofocus test at the feature (domain configuration)
P = DOMAIN_AF_FIRST;
xf_ = mmc.getXPosition(xyDev); yf_ = mmc.getYPosition(xyDev);
r_ = autofocusScript(zD, DOMAIN_AF);
if (r_[2] > 0.5) zD = r_[0];
if (START_AT_100X) say("  7. focus offset: domain - 100x = " + f3(zD - z100) + " um (autofocus at the offset position)");
t0 = System.currentTimeMillis(); for (int i = 0; i < 5; i++) { mmc.snapImage(); mmc.getImage(); } tSnap = (System.currentTimeMillis() - t0) / 5000.0;
n_ = (int) Math.round(2 * SWEEP_RANGE_UM / SWEEP_STEP_UM) + 1;
zs_ = new double[n_]; ms_ = new double[n_];
t0 = System.currentTimeMillis();
setZ(zD - SWEEP_RANGE_UM - AF_BACKLASH_UM);
for (int i = 0; i < n_; i++) {
    zs_[i] = zD - SWEEP_RANGE_UM + i * SWEEP_STEP_UM;
    ms_[i] = setZ(zs_[i]) ? sharpness(P[4]) : -1;
}
despike(zs_, ms_, P[4]);
sweepSec = (System.currentTimeMillis() - t0) / 1000.0;
bi_ = 0; for (int i = 0; i < n_; i++) if (ms_[i] > ms_[bi_]) bi_ = i;
v_ = new double[n_]; nv_ = 0; for (int i = 0; i < n_; i++) if (ms_[i] >= 0) v_[nv_++] = ms_[i];
med_ = median(java.util.Arrays.copyOf(v_, nv_));
half_ = med_ + 0.5 * (ms_[bi_] - med_);
lo_ = bi_; while (lo_ > 0 && ms_[lo_ - 1] >= half_) lo_--;
hi_ = bi_; while (hi_ < n_ - 1 && ms_[hi_ + 1] >= half_) hi_++;
fwhm_ = (hi_ - lo_ + 1) * SWEEP_STEP_UM;
csv_ = new FileWriter(OUT_DIR + "/" + NAME + "_sweep.csv", false);
csv_.write("z_um,sharpness\r\n");
for (int i = 0; i < n_; i++) csv_.write(zs_[i] + "," + ms_[i] + "\r\n");
csv_.close();
say("    sweep +-" + f1(SWEEP_RANGE_UM) + " um in " + SWEEP_STEP_UM + " um steps: sharpest at " + f3(zs_[bi_] - zD) + " um from the focus, peak/median " +
    f3(ms_[bi_] / med_) + ", peak width (FWHM) " + f1(fwhm_) + " um; " + f3(sweepSec / n_) + " s per frame (snap alone " + f3(tSnap) + " s)");
setZ(zs_[bi_] - AF_BACKLASH_UM); setZ(zs_[bi_]);
saveIP(snapIP(), NAME + "_domain_best.tif", "z_um=" + zs_[bi_] + "\ncamera=" + camD + "\nexposure_ms=" + expD);
rep_ = new double[REPEATS];
for (int i = 0; i < REPEATS; i++) rep_[i] = sharpness(P[4]);
m_ = 0; for (int i = 0; i < REPEATS; i++) m_ += rep_[i] / REPEATS;
sd_ = 0; for (int i = 0; i < REPEATS; i++) sd_ += (rep_[i] - m_) * (rep_[i] - m_) / REPEATS;
cv_ = Math.sqrt(sd_) / m_;
say("    sharpness noise at the peak: " + f3(cv_ * 100) + " % (" + REPEATS + " frames)");
try {
    pw = 700; ph = 380;
    bim = new java.awt.image.BufferedImage(pw, ph, java.awt.image.BufferedImage.TYPE_INT_RGB);
    gr = bim.createGraphics();
    gr.setRenderingHint(java.awt.RenderingHints.KEY_ANTIALIASING, java.awt.RenderingHints.VALUE_ANTIALIAS_ON);
    gr.setColor(java.awt.Color.WHITE); gr.fillRect(0, 0, pw, ph);
    mn = 1e30; mx = -1e30;
    for (int i = 0; i < n_; i++) if (ms_[i] >= 0) { mn = Math.min(mn, ms_[i]); mx = Math.max(mx, ms_[i]); }
    gr.setColor(java.awt.Color.LIGHT_GRAY); gr.drawRect(50, 30, pw - 70, ph - 80);
    gr.setColor(java.awt.Color.BLUE);
    for (int i = 1; i < n_; i++) {
        if (ms_[i] < 0 || ms_[i - 1] < 0) continue;
        gr.drawLine(50 + (int) ((i - 1) * (pw - 70.0) / (n_ - 1)), ph - 50 - (int) ((ms_[i - 1] - mn) / Math.max(mx - mn, 1e-12) * (ph - 80)),
                    50 + (int) (i * (pw - 70.0) / (n_ - 1)), ph - 50 - (int) ((ms_[i] - mn) / Math.max(mx - mn, 1e-12) * (ph - 80)));
    }
    gr.setColor(java.awt.Color.BLACK);
    gr.drawString(NAME + " domain camera: sharpness vs Z   peak/median " + f3(ms_[bi_] / med_) + ", FWHM " + f1(fwhm_) + " um", 10, 18);
    gr.drawString(f1(zs_[0]), 40, ph - 30); gr.drawString(f1(zs_[n_ - 1]), pw - 60, ph - 30); gr.drawString("Z (um)", pw / 2 - 20, ph - 30);
    gr.dispose();
    javax.imageio.ImageIO.write(bim, "png", new File(OUT_DIR + "/" + NAME + "_sweep.png"));
    if (!java.awt.GraphicsEnvironment.isHeadless()) new ij.ImagePlus(NAME + " sharpness vs Z", bim).show();
} catch (Throwable t) { say("  (plot not drawn: " + t + ")"); }
zBest = zs_[bi_];
res_ = new java.util.ArrayList();
for (int k = 0; k < TEST_OFFSETS_UM.length; k++) {
    for (int q = 0; q < 2; q++) {
        double[] pp = q == 0 ? DOMAIN_AF : DOMAIN_AF_FIRST;
        zst = zBest + TEST_OFFSETS_UM[k];
        setZ(zst);
        n0 = nSnaps; t1 = System.currentTimeMillis();
        r_ = autofocusScript(zst, pp);
        say("    autofocus (" + (q == 0 ? "DOMAIN_AF" : "DOMAIN_AF_FIRST") + ") from " + (TEST_OFFSETS_UM[k] >= 0 ? "+" : "") + f1(TEST_OFFSETS_UM[k]) + " um: " +
            (r_[2] > 0.5 ? f3(r_[0] - zBest) + " um from the sharpest" : "FAILED") + "; " + (nSnaps - n0) + " frames, " + f1((System.currentTimeMillis() - t1) / 1000.0) + " s");
        res_.add(new double[] { r_[0] - zBest, r_[2] });
    }
}
setZ(zBest - AF_BACKLASH_UM); setZ(zBest);

// ---- 8. summary
say("  --- result");
nf_ = 0; worst_ = 0;
for (int i = 0; i < res_.size(); i++) { double[] e = (double[]) res_.get(i); if (e[1] < 0.5) nf_++; else worst_ = Math.max(worst_, Math.abs(e[0])); }
say("  * autofocus: " + (res_.size() - nf_) + " of " + res_.size() + " runs passed, worst " + f3(worst_) + " um from the sharpest Z" +
    (worst_ > Math.max(0.3, fwhm_ / 4) ? "  <-- larger than a quarter of the peak width: smaller fine step" : ""));
if (ms_[bi_] / med_ < 1.3) say("  * the sharpness peak is weak (peak/median " + f3(ms_[bi_] / med_) + "): more light / exposure, or a feature with more edges");
if (cv_ > 0.05) say("  * the sharpness is noisy (" + f3(cv_ * 100) + " %): more exposure, or average frames");
if (fwhm_ > 0 && DOMAIN_AF[1] > fwhm_) say("  * DOMAIN_AF coarse step (" + DOMAIN_AF[1] + " um) is wider than the peak (" + f1(fwhm_) + " um): use a smaller coarse step");
if (fwhm_ < 2.5 * DOMAIN_AF[3]) say("  * the peak is narrow compared with the fine step (" + DOMAIN_AF[3] + " um): use a smaller fine step");
say("  copy into mm_chip_scan.bsh (stacking-domain settings):");
if (DOMAIN_CAMERA.length() == 0) say("    DOMAIN_CAMERA = \"" + camD + "\";");
say("    DOMAIN_EXPOSURE_MS = " + f3(expD) + ";");
if (START_AT_100X) {
    say("    DOMAIN_XY_OFFSET_UM = new double[] { " + f3(offX) + ", " + f3(offY) + " };   // " + xyHow);
    say("    DOMAIN_FOCUS_OFFSET_UM = " + f3(zD - z100) + ";");
}
say("    DOMAIN_UM_PER_PX = new double[] { " + f3(mD[0]) + ", " + f3(mD[1]) + ", " + f3(mD[2]) + ", " + f3(mD[3]) + " };   // for the analysis (not used by the scan)");
js_ = "{\"script_version\": \"" + SCRIPT_VERSION + "\", \"date\": \"" + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new java.util.Date()) +
      "\", \"camera\": \"" + camD + "\", \"exposure_ms\": " + expD + ", \"width\": " + W + ", \"height\": " + H +
      ", \"um_per_px_matrix\": [" + mD[0] + ", " + mD[1] + ", " + mD[2] + ", " + mD[3] + "], \"um_per_px\": " + pxD + ", \"mirrored\": " + mirror_ +
      ", \"rotation_vs_scan_camera_deg\": " + rotRel +
      (START_AT_100X ? ", \"xy_offset_um\": [" + offX + ", " + offY + "], \"xy_offset_method\": \"" + xyHow + "\", \"focus_offset_um\": " + (zD - z100) +
                       ", \"z100_um\": " + z100 + ", \"stage_100x_um\": [" + X0 + ", " + Y0 + "]" : "") +
      ", \"z_domain_um\": " + zD + ", \"sweep_fwhm_um\": " + fwhm_ + ", \"sharpness_noise\": " + cv_ + ", \"af_runs_passed\": " + (res_.size() - nf_) +
      ", \"af_runs\": " + res_.size() + ", \"af_worst_um\": " + worst_ + "}\n";
jw_ = new FileWriter(OUT_DIR + "/" + NAME + "_domain.json", false); jw_.write(js_); jw_.close();
say("done (" + nSnaps + " frames): " + OUT_DIR + "/" + NAME + "_log.txt, _domain.json, _sweep.csv/.png, _100x.tif, _domain_at_offset.tif, _domain_best.tif");
say("  the stage is at the feature with the domain configuration in place (Z " + f3(zBest) + ")");
try { LOG.close(); } catch (Throwable t) { }
